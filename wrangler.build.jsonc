{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Build-time only, read by @sveltejs/adapter-cloudflare and nothing else.
	//
	// The adapter writes its generated worker to whatever `main` points at in the
	// wrangler config it reads. Left to read wrangler.jsonc it would overwrite
	// src/worker/index.ts, our real entry point. So it gets this file instead,
	// where `main` is the adapter's own default location, and wrangler.jsonc is
	// free to point `main` at the entry that re-exports the Room durable object.
	"name": "wikigame",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
