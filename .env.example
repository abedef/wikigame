# Signs the player identity cookie. Must be identical to the SESSION_SECRET in
# .dev.vars, or the game server will reject connections from the dev pages.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Origin of the game server (durable object). Leave empty in production, where the
# pages and the game server are the same worker on the same origin.
PUBLIC_GAME_SERVER=http://localhost:8787
