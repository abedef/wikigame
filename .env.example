# Signs the player identity cookie. Must be identical to the SESSION_SECRET in
# .dev.vars, or the game server will reject connections from the dev pages.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Origin of the game server (durable object). Leave empty in production, where the
# pages and the game server are the same worker on the same origin.
PUBLIC_GAME_SERVER=http://localhost:8787

# The Discord application's client id. Public: it appears in the activity's own
# iframe URL. Only needed to run the Discord activity.
PUBLIC_DISCORD_CLIENT_ID=

# The matching client secret. Never commit it: put it in .dev.vars locally and
# in `wrangler secret put DISCORD_CLIENT_SECRET` for the deployed worker.
